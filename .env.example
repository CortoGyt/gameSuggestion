# Copier ce fichier en .env et remplir les valeurs. Ne jamais versionner .env.

# --- Base de donnees (MySQL lance par docker compose) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Format : mysql+pymysql://UTILISATEUR:MOT_DE_PASSE@localhost:3306/NOM_DE_LA_BASE
DATABASE_URL=

# --- APIs de donnees ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Utilise seulement par le test de connexion IGDB
IGDB_ACCESS_TOKEN=
STEAM_API_KEY=

# --- LLM ---
# Labelling de secours via l'API Groq (le labelling principal tourne en local avec Ollama)
GROQ_API_KEY=
GROQ_LABELLING_MODEL_ID=llama-3.1-8b-instant
# Adresse d'Ollama si elle differe de la valeur par defaut
# OLLAMA_URL=http://localhost:11434

# --- Suivi des experiences ---
MLFLOW_TRACKING_URI=http://localhost:5000
